# Configuração para alojamentos Apache ou LiteSpeed (ignorada noutros servidores).

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Redirecionar para https://www.gadgetmetodo.pt
# Ativar só depois de o certificado SSL estar ativo e se o alojamento não fizer já este redirecionamento.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.gadgetmetodo.pt%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .txt .html .css .js .xml .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
