# >>> certidoes.gadgetmetodo.pt (Gestão de Alertas)
# O plano tem um só site: certidoes.gadgetmetodo.pt é um alias desta pasta e é servido a partir de
# /subsites/certidoes (ponte do painel). Fica antes de todas as outras regras. A validação do certificado
# (/.well-known/acme-challenge/) fica no site, para a emissão e a renovação automática.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^certidoes\.gadgetmetodo\.pt$ [NC]
  RewriteCond %{REQUEST_URI} !^/subsites/certidoes(/|$)
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^(.*)$ /subsites/certidoes/$1 [L]
</IfModule>
# Por outros endereços (ex.: gadgetmetodo.pt/subsites/certidoes/) a ponte responde 404: verificação no index.php.
# <<< certidoes.gadgetmetodo.pt

# >>> alertas.gadgetmetodo.pt (Gestão de Alertas)
# O plano tem um só site: alertas.gadgetmetodo.pt é um alias desta pasta e é servido a partir de
# /subsites/alertas (ponte do painel). Fica antes de todas as outras regras.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^alertas\.gadgetmetodo\.pt$ [NC]
  RewriteCond %{REQUEST_URI} !^/subsites/alertas(/|$)
  RewriteRule ^(.*)$ /subsites/alertas/$1 [L]
</IfModule>
# Por outros endereços (ex.: gadgetmetodo.pt/subsites/alertas/) a ponte responde 404: verificação no index.php.
# <<< alertas.gadgetmetodo.pt

# Configuração para alojamentos Apache ou LiteSpeed (ignorada noutros servidores).

ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

# Endereços antigos
<IfModule mod_alias.c>
  Redirect 301 /servicos/formacao-ai-essentials/ /formacoes/ai-essentials/
</IfModule>

# Redirecionar para https://www.gadgetmetodo.pt
# Ativar só depois de o certificado SSL estar ativo e se o alojamento não fizer já este redirecionamento.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.gadgetmetodo.pt%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddType audio/mp4 .m4a
  AddCharset utf-8 .txt .html .css .js .xml .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
